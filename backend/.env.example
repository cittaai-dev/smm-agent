# Copy to backend/.env for local (non-docker) dev: `cp .env.example .env`.
# pydantic-settings reads this automatically (env_file=".env" in app/infra/settings.py),
# relative to the backend/ working directory -- not the repo root .env.example,
# which documents the same vars for the docker-compose environment: blocks instead.
# Never commit .env.

DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:5432/smm
# tests/conftest.py's autouse clean_db fixture TRUNCATEs on every test -- it
# points at TEST_DATABASE_URL, never DATABASE_URL, so running pytest can never
# wipe real dev/demo data again. Create it once: see backend/tests/conftest.py.
TEST_DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:5432/smm_test
REDIS_URL=redis://localhost:6379

SMM_API_CORS_ORIGINS=http://localhost:3000

SMM_LLM_OPENAI_API_KEY=
SMM_LLM_PLAN_MODEL=gpt-4.1-mini
SMM_LLM_SYNTHESIZE_MODEL=gpt-4.1
SMM_LLM_REPAIR_MODEL=gpt-4.1
SMM_LLM_SYNTHESIZE_TEMPERATURE=0.2
SMM_LLM_CONTEXT_MAX_TOKENS=6000
