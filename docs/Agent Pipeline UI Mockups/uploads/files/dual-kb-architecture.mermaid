flowchart TB

%% ═══════════════════════════════════════════════════════════
    subgraph SEAM["THE BRIDGE RELATION — written first, everything else is downstream"]
        BR["For each RUN UNIT, find the CORE UNIT that RELATION<br/><br/>e.g. for each requirement statement in the client BRD,<br/>find the D365 capability that satisfies it<br/><br/>this sentence fixes chunk granularity on BOTH sides"]
    end

%% ═══════════════════════════════════════════════════════════
%% CORE KB — build time
%% ═══════════════════════════════════════════════════════════
    subgraph CORE["CORE KB · BUILD TIME · offline · curated · trusted · versioned"]
        direction TB
        CS["curated sources<br/>domain docs, standards, product documentation"]
        CQ["Service Bus queue<br/>KEDA scaled Container Apps job"]
        CP["FULL PIPELINE — generous budget<br/>Stage 0 all three tiers · L0 to L3 ladder<br/>vision reorder ON · L3 budget high"]
        CG["EVAL GATE<br/>L0 ratio · degraded ratio<br/>citation rejection on golden set"]
        CV["PROMOTE to core:name@vN<br/>immutable · never mutated in place"]
        CS --> CQ --> CP --> CG
        CG -->|pass| CV
        CG -->|fail| CP
    end

%% ═══════════════════════════════════════════════════════════
%% RUN KB — run time
%% ═══════════════════════════════════════════════════════════
    subgraph RUN["RUN KB · RUN TIME · inline · UNTRUSTED · ephemeral · TTL"]
        direction TB
        RS["user upload for THIS run<br/>1 to 50 docs"]
        RH["content hash check<br/>P6 — re-upload is free"]
        RP["CONSTRAINED PIPELINE — hard timeout<br/>Stage 0 geometric only · L1 only<br/>no vision reorder · no L3 · finer granularity"]
        RQ["QUERY-UNIT chunking<br/>one claim / requirement per chunk<br/>chunks are QUERIES, not evidence"]
        RS --> RH --> RP --> RQ
    end

    SEAM -.fixes granularity.-> CP
    SEAM -.fixes granularity.-> RQ

%% ═══════════════════════════════════════════════════════════
%% TRUST BOUNDARY
%% ═══════════════════════════════════════════════════════════
    TB1["⛔ TRUST BOUNDARY — one way only<br/>Run KB content is DATA, never instruction<br/>Run to Core promotion is human-gated, never automatic"]

    RUN --> TB1
    TB1 -.blocked.-> CORE

%% ═══════════════════════════════════════════════════════════
%% STORE
%% ═══════════════════════════════════════════════════════════
    subgraph ST["ONE STORE · partitioned by kb_id · no forked schema"]
        direction LR
        SC[("kb_id = core:name@vN<br/>permanent · shared · grant scoped")]
        SR[("kb_id = run:run_id<br/>TTL · session grant only")]
        SE[("chunk_edges<br/>C8′ direction rule")]
    end

    CV --> SC
    RQ --> SR
    SC --- SE
    SR --- SE

%% ═══════════════════════════════════════════════════════════
%% RETRIEVAL
%% ═══════════════════════════════════════════════════════════
    subgraph RET["QUERY PATH · pins core_kb_version + run_kb_hash"]
        direction TB

        PIN["RUN MANIFEST<br/>run_id to core:name@vN + run_kb_hash<br/>this pair fully determines the evidence set"]

        PLAN["① PLAN — call site 1<br/>chooses TOPOLOGY, not just filters"]

        subgraph TOPO["TWO TOPOLOGIES"]
            direction LR
            U["UNION<br/>search both, RRF fuse<br/>'what does this say about X'"]
            B["BRIDGE — fan out<br/>each run chunk becomes a query<br/>against core only<br/>'map mine onto yours'"]
        end

        HYD["HYDRATE<br/>grant re-checked per edge<br/>run to core edges live in run scope"]
        CTX["ASSEMBLE<br/>evidence tagged by kb_id<br/>provenance never collapsed"]

        PIN --> PLAN --> TOPO --> HYD --> CTX
    end

    ST --> TOPO
    ST --> HYD

%% ═══════════════════════════════════════════════════════════
    subgraph GEN["GENERATE"]
        direction TB
        SY["② SYNTHESIZE — call site 2<br/>claims tagged with chunk_id AND kb_id"]
        VE["VERIFY — deterministic<br/>plus: is a core claim grounded in core?<br/>run-grounded claims cannot assert domain fact"]
        RE["③ REPAIR — call site 3"]
        OU["ANSWER<br/>citations separable by corpus"]
        SY --> VE
        VE -->|pass| OU
        VE -->|fail| RE --> VE
    end

    CTX --> SY

%% ═══════════════════════════════════════════════════════════
    subgraph RT["THREE RUNTIMES · separate deploy, separate scale, separate budget"]
        direction LR
        T1["CORE BUILDER<br/>batch · KEDA on queue depth<br/>minutes to hours · amortized cost"]
        T2["RUN INGEST<br/>inline · latency bound<br/>p95 target · per-run cost"]
        T3["QUERY<br/>hot · 3 call sites<br/>per-query cost"]
    end

    CORE -.-> T1
    RUN -.-> T2
    RET -.-> T3

    style SEAM fill:#fef9c3,stroke:#ca8a04,stroke-width:3px
    style CORE fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style RUN fill:#fff7ed,stroke:#ea580c,stroke-width:2px
    style TB1 fill:#fee2e2,stroke:#dc2626,stroke-width:3px
    style ST fill:#f1f5f9,stroke:#475569,stroke-width:2px
    style RET fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style GEN fill:#fef2f2,stroke:#dc2626,stroke-width:2px
    style RT fill:#faf5ff,stroke:#7c3aed,stroke-width:2px
    style TOPO fill:#dbeafe,stroke:#2563eb
    style VE fill:#fee2e2,stroke:#dc2626,stroke-width:2px
    style PIN fill:#e0f2fe,stroke:#0284c7,stroke-width:2px
