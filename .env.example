# Reference for infra/docker-compose.yml's environment: blocks. For local
# (non-docker) backend dev, use backend/.env.example instead -- pydantic-settings
# there reads backend/.env directly. Never commit .env.

# Database / broker
DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:5432/smm
REDIS_URL=redis://localhost:6379

# API (backend) — browser origins allowed to call the API cross-origin.
# Comma-separated. Must match where the frontend is actually served from.
SMM_API_CORS_ORIGINS=http://localhost:3000

# LLM — note the SMM_LLM_ prefix on every var, including the API key.
SMM_LLM_OPENAI_API_KEY=
SMM_LLM_PLAN_MODEL=gpt-4.1-mini
SMM_LLM_SYNTHESIZE_MODEL=gpt-4.1
SMM_LLM_REPAIR_MODEL=gpt-4.1
SMM_LLM_SYNTHESIZE_TEMPERATURE=0.2
SMM_LLM_CONTEXT_MAX_TOKENS=6000

# Auth — local-dev/demo only. Skips the api-key/brand-grant check entirely.
# Leave false/unset for anything that isn't your own machine.
SMM_AUTH_DEV_BYPASS=false
